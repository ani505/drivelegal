# ============================================
# DriveLegal Backend — Environment Variables
# ============================================

# App
APP_NAME=DriveLegal
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/drivelegal
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/drivelegal

# Vector DB (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=drivelegal_laws

# AI / LLM
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=anthropic   # anthropic | gemini

# Google Maps / Geo
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
IPINFO_TOKEN=your-ipinfo-token

# Redis (for caching & Celery)
REDIS_URL=redis://localhost:6379/0

# JWT Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OCR
TESSERACT_CMD=/usr/bin/tesseract

# Feature Flags
ENABLE_BLOCKCHAIN=false
ENABLE_COMPUTER_VISION=false
ENABLE_GAMIFICATION=false

# ─── Phase 2/3 Feature Flags ───────────────────────────────────────────────
ENABLE_BLOCKCHAIN=false
ENABLE_COMPUTER_VISION=false
ENABLE_GAMIFICATION=false

# Blockchain (Polygon Mainnet or Mumbai Testnet)
ETHEREUM_RPC_URL=https://polygon-rpc.com
WALLET_PRIVATE_KEY=your-wallet-private-key-here
CONTRACT_ADDRESS=0xYourDeployedViolationRegistryAddress
PAYMENT_ESCROW_ADDRESS=0xYourDeployedPaymentEscrowAddress
